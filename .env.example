# ===== GlobalBridge Mock 은행 서버 설정 =====
# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env

# 서버 포트
PORT=4000

# 호스트 (0.0.0.0 = 모든 인터페이스. 홈서버 외부 접근 시 필요)
HOST=0.0.0.0

# SQLite DB 파일 경로 (은행 자체 장부)
DB_PATH=./data/bank.db

# ===== mTLS 토글 =====
# false: 평문 HTTP (개발 초기, 흐름 검증용)
# true : 상호 TLS (데모/발표, 은행망 수준 보안)
TLS_ENABLED=false

# TLS_ENABLED=true 일 때만 사용. certs/generate-certs.sh 로 생성한 파일들.
TLS_SERVER_KEY=./certs/server-key.pem
TLS_SERVER_CERT=./certs/server-cert.pem
TLS_CA_CERT=./certs/ca-cert.pem
# 클라이언트 인증서 요구 여부 (mTLS의 핵심. false면 일반 HTTPS)
TLS_REQUEST_CLIENT_CERT=true
