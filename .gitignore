# ===== GlobalBridge Mock Bank .gitignore =====

# 의존성
node_modules/

# 환경 변수 (실제 값. .env.example만 커밋)
.env
.env.local
.env.*.local

# SQLite 은행 장부 DB (seed.json으로 재생성됨)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3

# TLS 인증서 / 키 (generate-certs.sh로 생성)
certs/*.pem
certs/*.p12
certs/*.key
certs/*.crt
certs/*.csr
certs/*.srl

# 로그
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 런타임 / 캐시
*.pid
*.seed
.cache/
coverage/
.nyc_output/

# OS 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# 에디터 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 빌드 산출물
dist/
build/